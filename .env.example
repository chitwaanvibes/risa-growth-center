# Copy to .env for local runs. On Vercel, add these in Project > Settings > Environment Variables.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
GEMINI_API_KEY=your_key_from_google_ai_studio
# Optional: models tried in order (first that works is used)
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Optional: if set, edits require this passcode (entered once in the app)
APP_PASSCODE=
